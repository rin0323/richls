#compdef richls

autoload -U is-at-least

_richls() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--sort=[Sort by name, size, or mtime]:KEY:(name size mtime)' \
'-l[Show metadata, human-readable sizes, and rich information]' \
'--long[Show metadata, human-readable sizes, and rich information]' \
'-a[Show hidden files]' \
'--all[Show hidden files]' \
'--respect-ignore[Hide entries matched by .gitignore or .dockerignore]' \
'--complete[Generate shell completion files]' \
'--humanize[]' \
'--pdf-title[]' \
'--new-mark[]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'::path -- Path to list:_files' \
&& ret=0
}

(( $+functions[_richls_commands] )) ||
_richls_commands() {
    local commands; commands=()
    _describe -t commands 'richls commands' commands "$@"
}

if [ "$funcstack[1]" = "_richls" ]; then
    _richls "$@"
else
    compdef _richls richls
fi
